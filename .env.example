# Copy this file to ".env" and fill in the values, then: docker compose up --build
# (docker compose auto-loads .env from this folder.)
#
# Draftly runs in REAL mode by default: real Gmail (OAuth2) + a real LLM.
# To run with NO accounts instead, uncomment SPRING_PROFILES_ACTIVE=mock below.

# ===== Mode selection =====
DRAFTLY_GMAIL_MODE=real            # real | mock
DRAFTLY_LLM_PROVIDER=openai        # openai | anthropic | mock
DRAFTLY_EMBEDDING_PROVIDER=openai  # openai | hashing (RAG style-sample embeddings)
DRAFTLY_VECTOR_STORE=pgvector      # pgvector | memory (RAG similarity search)
# SPRING_PROFILES_ACTIVE=mock      # uncomment for zero-setup mock mode (H2 + fakes)

# ===== OpenAI (default LLM provider) =====
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# ===== Anthropic (only if DRAFTLY_LLM_PROVIDER=anthropic) =====
ANTHROPIC_API_KEY=

# ===== Gmail OAuth2 (required for real Gmail mode) =====
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/gmail/callback

# ===== Token encryption key (Base64, 16/24/32 bytes). Override in production! =====
DRAFTLY_ENCRYPTION_KEY=hEOJ0M+xSp8dJydJwP5o5BH+bWJ+BAAXePOvdn1nlxA=

# ===== JWT signing secret (Base64, HMAC-SHA256). Override in production! =====
DRAFTLY_JWT_SECRET=HC8oH6d4ROfnLFLT98wXIMJDYmPlAkYtjNd2tr8YMTQ=

# ===== Demo login (seeded on first startup) =====
# Email: demo.user@draftly.app  /  Password: demo1234
# Or register your own account via POST /api/auth/register.

# ===== PostgreSQL credentials (used by docker-compose) =====
POSTGRES_USER=draftly
POSTGRES_PASSWORD=draftly
